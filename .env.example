# Local development uses the D1-backed vinext runtime.
# Apply local migrations with `npm run db:migrate:local` before starting a compatibility-only Next dev server.
# Leave blank locally. Hosted production must set this exact canonical origin.
KAIROS_APP_URL=

# Google Calendar OAuth client registration.
GOOGLE_CALENDAR_CLIENT_ID=
# Google configurations may omit a client secret where the provider registration permits it.
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Calendar registration. Local development may use a public-client localhost redirect.
MICROSOFT_CALENDAR_CLIENT_ID=
# Hosted production uses a confidential Web redirect and requires this secret.
MICROSOFT_CALENDAR_CLIENT_SECRET=
# "common" supports both personal Microsoft accounts and work/school accounts.
MICROSOFT_CALENDAR_TENANT=common

# Keep disabled in normal use. Fixture-only routes return 404 unless this is 1.
E2E_FIXTURES=0

# Kairos account authentication (Auth.js).
# Generate a strong random value for hosted environments; never commit a real value.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Application-level credential encryption key for hosted persistence.
# Configure a real 32-byte key through the deployment secret store; never commit it.
KAIROS_CREDENTIAL_KEY_V1=
