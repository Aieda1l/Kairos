# Local development uses the D1-backed vinext runtime.
# Apply local migrations with `npm run db:migrate:local` before starting a compatibility-only Next dev server.
# Leave blank locally. Hosted production must set this exact canonical origin.
KAIROS_APP_URL=
AUTH_URL=

# Google Calendar OAuth client registration.
GOOGLE_CALENDAR_CLIENT_ID=
# Google configurations may omit a client secret where the provider registration permits it.
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Calendar registration. Local development may use a public-client localhost redirect.
MICROSOFT_CALENDAR_CLIENT_ID=
# Hosted production uses a confidential Web redirect and requires this secret.
MICROSOFT_CALENDAR_CLIENT_SECRET=
# "common" supports both personal Microsoft accounts and work/school accounts.
MICROSOFT_CALENDAR_TENANT=common

# Keep disabled in normal use. Fixture-only routes return 404 unless this is 1.
E2E_FIXTURES=0

# Kairos account authentication (Auth.js).
# Generate a strong random value for hosted environments; never commit a real value.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Application-level credential encryption key for hosted persistence.
# Configure a real 32-byte key through the deployment secret store; never commit it.
KAIROS_CREDENTIAL_KEY_V1=

# Abuse admission is loaded only for guarded work; it does not gate session reads.
# Turnstile sitekey is public in use; secret and HMAC key remain server-only.
KAIROS_TURNSTILE_SITE_KEY=
KAIROS_TURNSTILE_SECRET_KEY=
# Dedicated canonical unpadded base64url encoding of 32 random bytes.
# Never reuse the credential encryption key. Keep this v1 key stable across
# deployments while admitted rate events remain live (up to 3600 seconds).
KAIROS_ABUSE_KEY_V1=

# Server-controlled ingress, default none (public admission fails closed).
# Set cloudflare only for edge-only ingress with no untrusted same-zone Worker
# that can rewrite client addressing. Never infer trust from a request header.
# Only CF-Connecting-IP is used; Pseudo IPv4 overwrite uses CF-Connecting-IPv6.
# IPv4 is normalized exactly; IPv6 addresses share their /64 network budget.
KAIROS_ABUSE_TRUSTED_INGRESS=none

# Optional server-only JSON overrides, keyed by class. Unknown keys/fields fail.
# Every budget requires both integers: limit 1..1000, windowSeconds 1..3600.
# Empty uses these defaults; body/header/query parameters cannot override them.
# KAIROS_ABUSE_BUDGETS={"auth-initiation":{"limit":20,"windowSeconds":600},"credential":{"limit":10,"windowSeconds":600},"source-sync":{"limit":12,"windowSeconds":600},"calendar-sync":{"limit":12,"windowSeconds":600},"sync-all":{"limit":6,"windowSeconds":600},"deletion":{"limit":5,"windowSeconds":3600}}
KAIROS_ABUSE_BUDGETS=
# Admitted events carry a one-hour purge timestamp. 7C owns actual cleanup:
# at least daily, bounded indexed batches. Running/uncertain locks never expire
# automatically; ten-minute Sync All run admission/claims are implemented in B5.
