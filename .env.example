# Optional: override where local SQLite data is stored.
ASSIGNMENTS_DB_PATH=.data/assignments.sqlite

# Google Calendar OAuth desktop-app registration.
# Create a local/desktop OAuth client in Google Cloud Console and copy its client ID here.
GOOGLE_CALENDAR_CLIENT_ID=
# Some Google desktop client configurations provide a client secret. Leave blank if yours does not.
GOOGLE_CALENDAR_CLIENT_SECRET=

# Microsoft Calendar public-client application registration.
# Configure a Mobile and desktop application / public client with a localhost redirect.
MICROSOFT_CALENDAR_CLIENT_ID=
# "common" supports both personal Microsoft accounts and work/school accounts.
MICROSOFT_CALENDAR_TENANT=common

# Keep disabled in normal use. Fixture-only routes return 404 unless this is 1.
E2E_FIXTURES=0

# Kairos account authentication (Auth.js).
# Generate a strong random value for hosted environments; never commit a real value.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# Application-level credential encryption key for hosted persistence.
# Configure a real 32-byte key through the deployment secret store; never commit it.
KAIROS_CREDENTIAL_KEY_V1=
