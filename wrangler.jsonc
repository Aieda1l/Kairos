{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kairos",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": false,
    "redact_query_string": true,
    "logs": {"enabled": false, "invocation_logs": false, "persist": false},
    "traces": {"enabled": false, "persist": false}
  },
  "vars": {
    "KAIROS_APP_URL": "http://127.0.0.1:3000",
    "AUTH_URL": "http://127.0.0.1:3000",
    "KAIROS_LOCAL_AUTH": "loopback",
    "KAIROS_ABUSE_TRUSTED_INGRESS": "loopback"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kairos",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kairos-preview",
          "database_id": "22222222-2222-2222-2222-222222222222"
        }
      ]
    },
    "production": {
      "vars": {
        "KAIROS_APP_URL": "https://mykairos.me",
        "AUTH_URL": "https://mykairos.me",
        "KAIROS_ABUSE_TRUSTED_INGRESS": "cloudflare"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "kairos-production",
          "database_id": "11111111-1111-1111-1111-111111111111"
        }
      ]
    }
  },
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  }
}
