{
  "manifest_version": 3,
  "name": "Kairos Bridge",
  "version": "0.3.0",
  "description": "Lets Kairos read normalized Canvas and Gradescope data from already signed-in Firefox tabs.",
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  },
  "permissions": [
    "tabs"
  ],
  "host_permissions": [
    "https://canvas.uw.edu/*",
    "https://www.gradescope.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://mykairos.me/*"
  ],
  "background": {
    "scripts": [
      "dist/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://mykairos.me/*"
      ],
      "js": [
        "dist/kairos-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://canvas.uw.edu/*"
      ],
      "js": [
        "dist/canvas-content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.gradescope.com/*"
      ],
      "js": [
        "dist/gradescope-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Kairos",
    "default_icon": {
      "48": "icon48.png",
      "96": "icon96.png"
    },
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "kairos-local@kairos",
      "strict_min_version": "128.0"
    }
  }
}
